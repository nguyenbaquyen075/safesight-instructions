// SafeSight — SQLite schema (dev)
// For production with PostgreSQL, revert provider to "postgresql"
// and restore enum types + array fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// --- Models (SQLite-compatible: no enums, no native arrays) ---

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("starter")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  sites Site[]
}

model Site {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  address           String
  lat               Float
  lng               Float
  status            String   @default("SETUP")
  cameraCount       Int      @default(0)
  onlineCameraCount Int      @default(0)
  workerCount       Int      @default(0)
  complianceRate    Float    @default(0)
  activeAlerts      Int      @default(0)
  todayViolations   Int      @default(0)
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cameras      Camera[]
  zones        Zone[]
  violations   Violation[]
  alertRules   AlertRule[]
}

model Camera {
  id               String   @id @default(cuid())
  siteId           String
  name             String
  rtspUrl          String
  status           String   @default("OFFLINE")
  type             String   @default("fixed")
  location         String
  fps              Int      @default(15)
  resolution       String   @default("1920x1080")
  lastHealthCheck  DateTime @default(now())
  lastDetectionAt  DateTime?
  thumbnailUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zones      Zone[]
  violations Violation[]
}

model Zone {
  id               String   @id @default(cuid())
  siteId           String
  cameraId         String
  name             String
  type             String   @default("MONITORING")
  polygonData      String   // JSON string
  schedule         String?  // JSON string
  isActive         Boolean  @default(true)
  maxOccupancy     Int?
  currentOccupancy Int?
  violationCount   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  camera     Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  violations Violation[]
}

model Violation {
  id          String   @id @default(cuid())
  cameraId    String
  siteId      String
  zoneId      String?
  type        String
  severity    String
  confidence  Float
  bboxData   String   // JSON string
  snapshotUrl String
  clipUrl     String?
  status      String   @default("OPEN")
  occurrenceCount Int  @default(1) // lần vi phạm liên tục thứ mấy của người này (reset khi rời khung hình)
  agentReview String?  // JSON: { verdict, band, observations, note, sessionId, reviewedAt }
  detectedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  camera Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  alerts Alert[]
}

model Alert {
  id               String   @id @default(cuid())
  violationId      String
  ruleId          String?
  channel         String
  recipient       String
  status          String   @default("NEW")
  errorMessage    String?
  sentAt          DateTime @default(now())
  acknowledgedById String?
  acknowledgedAt  DateTime?
  escalatedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  violation      Violation  @relation(fields: [violationId], references: [id], onDelete: Cascade)
  alertRule     AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  acknowledgedBy User?     @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)
}

model AlertRule {
  id              String @id @default(cuid())
  siteId          String
  name            String
  violationTypes  String // JSON array
  channels        String // JSON array
  recipients      String // JSON array
  threshold       Int    @default(1)
  cooldownSec     Int    @default(300)
  schedule        String? // JSON string
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  alerts Alert[]
}

model User {
  id               String   @id @default(cuid())
  orgId            String
  email            String   @unique
  passwordHash     String?
  name             String
  role             String   @default("SAFETY_OFFICER")
  avatarUrl        String?
  assignedSites    String   // JSON array
  isActive         Boolean  @default(true)
  twoFactorEnabled Boolean  @default(false)
  lastLogin        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  acknowledgedAlerts Alert[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String
  createdAt  DateTime @default(now())
}

model TelegramSettings {
  id                String   @id @default(cuid())
  botTokenEncrypted String?
  isEnabled         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AgentTask {
  id          String    @id @default(cuid())
  kind        String
  subjectType String?
  subjectId   String?
  reason      String
  priority    Int       @default(0)
  budget      Int       @default(6)
  attempts    Int       @default(0)
  dueAt       DateTime
  leasedUntil DateTime?
  sessionId   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())

  @@index([dueAt, leasedUntil])
  @@index([subjectType, subjectId])
}

model AgentEvent {
  id          String   @id @default(cuid())
  sessionId   String
  taskId      String?
  subjectType String?
  subjectId   String?
  type        String
  data        String   // JSON string
  emittedAt   DateTime @default(now())

  @@index([sessionId, emittedAt])
  @@index([subjectType, subjectId, emittedAt])
}

model AgentSettings {
  id            String   @id @default(cuid())
  isEnabled     Boolean  @default(true)
  model         String   @default("claude-opus-5")
  reviewEffort  String   @default("medium")
  dailyTokenCap Int      @default(2000000)
  shiftReportAt String   @default("17:30")
  updatedAt     DateTime @updatedAt
}
