# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — chứa secret thật (DB URL, NEXTAUTH_SECRET), KHÔNG commit
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
dev.db
dev.db-wal
dev.db-shm

# ===== Chống phồng repo (SafeSight) =====
# Ảnh vi phạm tự sinh khi chạy YOLO — KHÔNG commit (giữ bộ demo 20260427)
/public/snapshots/*
# Model weights — đặt/tải tay, không commit
*.pt
# Kết quả & dữ liệu train
/runs/
/training/dataset/
# Python cache
__pycache__/
*.pyc

# git worktrees (local scratch, not committed)
.worktrees/

# Dataset train (3.3GB: ảnh gộp + zip gốc) — quá nặng cho git, GitHub chặn file >100MB.
# Zip gộp tự dựng lại được bằng data_train/merge_datasets.py nên chỉ giữ script.
/data_train/*
!/data_train/merge_datasets.py
# Ảnh webcam của anh: KHÔNG tái tạo được (quay tay trần / tay đeo găng để dạy
# model phân biệt ở cự ly gần). Nhẹ (~8MB) nên giữ trong repo.
# gang_tu_gan/ thì KHÔNG giữ — 90MB và dựng lại được từ 2 video đã commit.
!/data_train/tay_tran/
!/data_train/tay_tran/**
!/data_train/tay_gang/
!/data_train/tay_gang/**

# DB tạm cho test agent (npm run test:agent)
agent-test.db*

# Sơ đồ BA: chỉ commit PNG
/docs/ba/diagrams/*.excalidraw
