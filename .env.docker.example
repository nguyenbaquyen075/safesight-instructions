# Chép thành .env rồi điền giá trị thật (docker compose đọc file .env). KHÔNG commit .env.
NEXTAUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
AI_ENGINE_SECRET=           # openssl rand -base64 24 — AI engine gửi kèm header X-AI-Engine-Secret; bảo vệ cả POST /api/violations lẫn POST /detections của bridge
TELEGRAM_ENCRYPT_KEY=       # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENT_BRIDGE_SECRET=        # openssl rand -base64 24
NEXT_PUBLIC_YOLO_SERVER_URL=http://localhost:4001   # URL bridge mà TRÌNH DUYỆT truy cập được
ROBOFLOW_API_KEY=           # tuỳ chọn
