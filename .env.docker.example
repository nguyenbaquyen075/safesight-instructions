# Chép thành .env rồi điền giá trị thật (docker compose đọc file .env). KHÔNG commit .env.
# UID=                # id -u của anh, chỉ cần nếu khác 1000 — dashboard container chạy bằng uid
# GID=                # này (mặc định 1000:1000) để ghi được ./data, ./public/snapshots bind mount
# --- Cơ sở dữ liệu ---
# Mặc định (bỏ trống cả 4 dòng dưới) = SQLite trong bind mount ./data, y như trước.
# Dùng PostgreSQL (xem wiki/03 mục "Chuyển sang PostgreSQL"): chạy `docker compose --profile pg`,
# đặt DATABASE_URL + POSTGRES_PASSWORD, và DỰNG LẠI image dashboard với PRISMA_SCHEMA/
# BUILD_DATABASE_URL (Prisma 7 sinh client theo provider của schema, một client chỉ nói một loại DB).
DATABASE_URL=               # để trống = file:./data/dev.db; Postgres: postgresql://safesight:<mat_khau>@postgres:5432/safesight
POSTGRES_USER=safesight
POSTGRES_PASSWORD=          # bắt buộc khi chạy --profile pg
POSTGRES_DB=safesight
PRISMA_SCHEMA=              # để trống = prisma/schema.prisma; Postgres: prisma/postgres/schema.prisma
BUILD_DATABASE_URL=         # để trống = file:./data/dev.db; Postgres: postgresql://build/build (URL giả, chỉ dùng lúc build)
AGENT_WORKER_ID=            # tuỳ chọn — tên worker agent ghi vào sự kiện session.started; mặc định <hostname>-<pid>

NEXTAUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
AI_ENGINE_SECRET=           # openssl rand -base64 24 — AI engine gửi kèm header X-AI-Engine-Secret; bảo vệ cả POST /api/violations lẫn POST /detections của bridge
TELEGRAM_ENCRYPT_KEY=       # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" — mã hoá cả bot token Telegram lẫn access token Zalo OA
WEBHOOK_SECRET=             # openssl rand -base64 32 — ký body webhook (header X-SafeSight-Signature); thiếu thì kênh webhook không gửi
PUBLIC_BASE_URL=            # tuỳ chọn — URL công khai của dashboard, để Zalo OA tải được ảnh snapshot và webhook nhận URL tuyệt đối
AGENT_BRIDGE_SECRET=        # openssl rand -base64 24
NEXT_PUBLIC_YOLO_SERVER_URL=http://localhost:4001   # URL bridge mà TRÌNH DUYỆT truy cập được
ROBOFLOW_API_KEY=           # tuỳ chọn
ALLOW_DEV_LOGIN=false       # image chạy NODE_ENV=production: tài khoản dev admin@safesight.ai bị tắt trừ khi =true
# Agent lane nghiên cứu (tuỳ chọn) — xem wiki/09-agent.md mục "Nhà cung cấp LLM"
ANTHROPIC_API_KEY=          # tuỳ chọn
LLM_PROVIDER=               # anthropic (mặc định) | openai nếu key là proxy /chat/completions
LLM_BASE_URL=               # URL gốc của endpoint, mặc định lấy ANTHROPIC_BASE_URL
LLM_API_KEY=                # key của endpoint, mặc định lấy ANTHROPIC_API_KEY
LLM_MODEL_DEFAULT=          # tên model ghi vào cài đặt agent lần đầu
LLM_IMAGE_INPUT=            # true để gửi ảnh snapshot ở chế độ openai
